# Copy settings into your ignored .env file; do not overwrite an existing file.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Set a private, persistent random value to keep local sessions across restarts.
# Both keys below are required when DJANGO_DEBUG=false.
DJANGO_SECRET_KEY=
NEWS_API_KEY=
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen3:0.6b
OLLAMA_TEMPERATURE=0.2
OLLAMA_MAX_TOKENS=2000
